# Airi 2.0 configuration

# ─── Required ────────────────────────────────────────────────────────────────
# Discord bot token: https://discord.com/developers/applications -> Bot -> Token
# Also enable the MESSAGE CONTENT intent on that page, or the bot sees no commands.
DISCORD_BOT_TOKEN=

# ─── Optional: bot owner channels (numeric channel IDs) ──────────────────────
# Channel that gets "Airi is online" and guild-join notices.
PERSONAL_CHANNEL_ID=
# Channel that receives `.bug` reports.
BUG_REPORT_CHANNEL_ID=

# ─── AI companion ───────────────────────────────────────────────
# Providers are tried in this order; the first one configured wins.
# With NONE set, Airi falls back to canned keyword replies (repetitive by design).

# 1. Local moeru-ai/airi or any OpenAI-compatible server, e.g. http://localhost:11434/v1
AIRI_SERVER_URL=
# Aliases accepted for the same thing: AIRI_BASE_URL, MOERU_AIRI_URL
AIRI_API_KEY=
AIRI_MODEL=airi

# 2. NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash

# 3. OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4. Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 5. OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 6. Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 7. Ollama, local — e.g. http://localhost:11434
OLLAMA_HOST=
OLLAMA_MODEL=llama3

# Optional persona overrides (defaults live in cogs/ai.py)
AIRI_SYSTEM_PROMPT=
NSFW_AIRI_SYSTEM_PROMPT=

# ─── Music: Spotify ──────────────────────────────────────────
# https://developer.spotify.com/dashboard -> Create app -> Client ID / Secret
# Only used to resolve track/playlist NAMES; audio always streams from YouTube.
# Without these, a slower embed-page scraper is used instead.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Reddit ────────────────────────
# https://www.reddit.com/prefs/apps -> create an app of type "script".
# CLIENT_ID is the string under the app name; SECRET is the "secret" field.
# Username/password are optional (read-only access works without them) and
# will NOT work on accounts with 2FA enabled.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=AiriBot/1.0 by u/yourusername

# ─── Wallpapers ────────────────────────────────────────────────
# Unsplash access key: https://unsplash.com/developers
# Optional — falls back to wallhaven.cc, which needs no key.
UNSPLASH_CLIENT_ID=
